---
/**
 * Shared shell for the homepage, the work index and the builder. The printable
 * CV keeps its own page-level markup, because its whole job is to be one A4
 * document.
 */
import { config, resolveMode } from '../lib/career';

interface Props {
  title: string;
  description?: string;
  active?: 'work' | 'cv' | 'build';
  wide?: boolean;
  /**
   * Unlisted pages (/cv, /build) still build and deploy, but nothing public
   * links to them and search engines are asked to skip them. Unlisted is not
   * private: anyone with the URL can still read the page.
   */
  unlisted?: boolean;
  /**
   * The homepage carries the name as its hero, so the header would say it twice.
   * With this set the header goes sticky and the brand only fades in once the
   * hero nameplate has scrolled away.
   */
  foldBrand?: boolean;
  /** For pages that already end in a contact block, so the footer would repeat it. */
  bareFoot?: boolean;
}

const {
  title,
  description = config.tagline,
  active,
  wide = false,
  unlisted = false,
  foldBrand = false,
  bareFoot = false,
} = Astro.props;
const mode = resolveMode();

// No public nav. Every destination is reachable from the page body instead: the
// hero has "See the work" and "Get in touch", each section has its own "All N"
// link, and detail pages carry a breadcrumb. A bar with one item in it was doing
// less work than the buttons already on the page.
const nav: { href: string; label: string; key: string }[] = [];

// The unlisted pair appears only once you are already on one of them, so the two
// stay navigable between without any public page advertising either.
const unlistedNav = [
  { href: '/cv', label: 'CV', key: 'cv' },
  { href: '/build', label: 'Build a CV', key: 'build' },
];

const links = unlisted ? [...nav, ...unlistedNav] : nav;

const fontUrl =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap';
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {unlisted && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontUrl} />
    {/* Marks the document as scripted before first paint, so the folded brand
        starts hidden without a flash. Without JS it simply stays visible. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-head no-print', { fold: foldBrand }]}>
      <div class="site-head-inner">
        <a class="site-brand" href="/">
          <span class="site-name">{config.name}</span>
          <span class="site-tagline">{config.tagline}</span>
        </a>
        {links.length > 0 && (
          <nav class="site-nav" aria-label="Sections">
            {links.map((item) => (
              <a href={item.href} class:list={['site-nav-link', { on: active === item.key }]}>
                {item.label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    {mode === 'private' && (
      <div class="mode-banner no-print">
        Private build: real client names. Do not deploy.
      </div>
    )}

    <main id="main" class:list={['site-main', { wide }]}>
      <slot />
    </main>

    {!bareFoot && (
      <footer class="site-foot no-print">
        <span>{config.location}</span>
        <a href={`mailto:${config.email}`}>{config.email}</a>
        <a href={config.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={config.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </footer>
    )}

    {foldBrand && (
      <script>
        // The header brand appears only once the hero nameplate has left the
        // viewport, so the name is never on screen twice. An observer rather
        // than a scroll handler: no work on frames where nothing crossed.
        const head = document.querySelector('.site-head.fold');
        const nameplate = document.getElementById('hero-name');
        if (head && nameplate) {
          new IntersectionObserver(
            ([entry]) => head.classList.toggle('showing', !entry.isIntersecting),
            { threshold: 0 },
          ).observe(nameplate);
        }
      </script>
    )}
  </body>
</html>
