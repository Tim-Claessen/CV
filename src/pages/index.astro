---
/**
 * The front door. Editorial in the same language as the printable CV — display
 * type, numbered sections, hairlines — but built as a web page: a statement, a
 * selection of work, what it adds up to, and a way to get in touch. The full
 * filterable record lives at /work.
 */
import Site from '../layouts/Site.astro';
import {
  config,
  persona,
  projects,
  roles,
  allCapabilities,
  focuses,
  proficiencySegments,
  resolveMode,
  meta,
} from '../lib/career';
import '../styles/portfolio.css';
import '../styles/home.css';

const mode = resolveMode();
const allProjects = projects(mode);
const timeline = roles('all', mode);
const capabilities = allCapabilities(mode);
const areas = focuses(mode);

// The profile paragraph, promoted typographically: its opening sentence is the
// hero statement and the rest is the lede. Tim's own CV wording either way — the
// homepage never invents copy. A sentence ends at a full stop before a capital.
const profile = persona('all')?.profile ?? '';
const opening = /^(.+?\.)\s+([\s\S]*)$/.exec(profile);
const statement = opening?.[1] ?? profile;
const lede = opening?.[2] ?? '';

const selected = allProjects.filter((project) => project.featured).slice(0, 6);

/**
 * Enough to show range without turning the front page into the index. Ordered by
 * evidence rather than by level: sorting on level alone returns eight identical
 * meters, which tells a reader nothing.
 */
const highlights = (kind: 'skill' | 'technology') =>
  capabilities
    .filter((item) => item.kind === kind && item.proficiency !== null)
    .sort((a, b) => b.evidenceCount - a.evidenceCount || a.name.localeCompare(b.name))
    .slice(0, 8);
---

<Site title={`${config.name} — ${config.tagline}`} description={statement}>
  <section class="hero">
    <p class="hero-eyebrow">{config.tagline}</p>
    <h1 class="hero-statement">{statement}</h1>
    <div class="hero-rule" aria-hidden="true"></div>
    {lede && <p class="hero-lede">{lede}</p>}
    <div class="hero-actions">
      <a class="action action-primary" href="/work">See the work</a>
      <a class="action" href={`mailto:${config.email}`}>Get in touch</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="selected-heading">
    <div class="home-head">
      <span class="home-num">01</span>
      <h2 class="home-title" id="selected-heading">Selected work</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <ol class="entries">
      {selected.map((project) => (
        <li class="entry">
          <a class="entry-link" href={`/projects/${project.slug}`}>
            <span class="entry-when">{project.year}</span>
            <span class="entry-body">
              <span class="entry-client">
                {project.client ?? 'Multiple organisations'}
                {project.projectType && <span class="entry-type"> · {project.projectType}</span>}
              </span>
              <span class="entry-title">{project.title}</span>
              <span class="entry-summary">{project.summary}</span>
              {project.technologies.length > 0 && (
                <span class="entry-stack">
                  {project.technologies.slice(0, 4).map((tech) => (
                    <span class="chip">{tech}</span>
                  ))}
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ol>

    <a class="more" href="/work">All {allProjects.length} projects</a>
  </section>

  <section class="home-section" aria-labelledby="focus-heading">
    <div class="home-head">
      <span class="home-num">02</span>
      <h2 class="home-title" id="focus-heading">What I do</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <div class="focus-grid">
      {areas.map((area) => (
        <a class="focus" href={`/work?type=${encodeURIComponent(area.name)}`}>
          <span class="focus-count">{area.count}</span>
          <span class="focus-name">{area.name}</span>
          <span class="focus-summary" set:html={area.summary} />
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="caps-heading">
    <div class="home-head">
      <span class="home-num">03</span>
      <h2 class="home-title" id="caps-heading">Capabilities</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <div class="cap-columns">
      {([['Skills', 'skill'], ['Technologies', 'technology']] as const).map(([label, kind]) => (
        <div class="cap-column">
          <h3 class="cap-column-title">{label}</h3>
          <ul class="cap-highlights">
            {highlights(kind).map((item) => (
              <li>
                <a class="cap-highlight" href={`/capabilities/${item.slug}`}>
                  <span class="cap-highlight-name">{item.name}</span>
                  <span class="cap-highlight-level">
                    <span class="cap-highlight-word">{item.proficiency}</span>
                    <span class="meter" aria-label={item.proficiency ?? ''}>
                      {[1, 2, 3].map((n) => (
                        <span class:list={['seg', { on: n <= proficiencySegments(item.proficiency) }]} />
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <a class="more" href="/work#capabilities">All {capabilities.length} capabilities</a>
  </section>

  <section class="home-section" aria-labelledby="record-heading">
    <div class="home-head">
      <span class="home-num">04</span>
      <h2 class="home-title" id="record-heading">Track record</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <div class="record">
      {timeline.map((role) => (
        <article class="record-role">
          <div class="record-when">{role.start} → {role.end}</div>
          <div>
            <h3 class="record-title">
              {role.title} <span class="record-employer">{role.employer}</span>
            </h3>
            {role.summary && <p class="record-summary">{role.summary}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" id="contact" aria-labelledby="contact-heading">
    <div class="home-head">
      <span class="home-num">05</span>
      <h2 class="home-title" id="contact-heading">Get in touch</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <dl class="contact-grid">
      <div><dt>Email</dt><dd><a href={`mailto:${config.email}`}>{config.email}</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={config.linkedinUrl} rel="noopener noreferrer">{config.linkedin}</a></dd></div>
      <div><dt>GitHub</dt><dd><a href={config.githubUrl} rel="noopener noreferrer">{config.github}</a></dd></div>
      <div><dt>Based in</dt><dd>{config.location}</dd></div>
    </dl>

    <p class="colophon">
      Facts generated from lore on {meta.generated}{meta.source.commit && <> · {meta.source.commit}</>}.
      Client names are withheld where the engagement isn't mine to name.
    </p>
  </section>
</Site>
