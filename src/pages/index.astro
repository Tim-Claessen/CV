---
/**
 * The front door. Editorial in the same language as the printable CV (display
 * type, numbered sections, hairlines) but built as a web page. The nameplate is
 * the hero; as it scrolls away it folds up into the sticky header, so the header
 * carries the name only once the hero no longer does. The full filterable record
 * lives at /work.
 */
import Site from '../layouts/Site.astro';
import {
  config,
  persona,
  projects,
  roles,
  allCapabilities,
  focuses,
  resolveMode,
} from '../lib/career';
import '../styles/portfolio.css';
import '../styles/home.css';

const mode = resolveMode();
const allProjects = projects(mode);
const timeline = roles('all', mode);
const capabilities = allCapabilities(mode);
const areas = focuses(mode);

const profile = persona('all')?.profile ?? '';
const selected = allProjects.filter((project) => project.featured).slice(0, 6);

const skills = capabilities.filter((item) => item.kind === 'skill');
const technologies = capabilities.filter((item) => item.kind === 'technology');
---

<Site
  title={`${config.name} · ${config.tagline}`}
  description={profile.split('. ')[0]}
  foldBrand
  bareFoot
>
  <section class="hero">
    <h1 class="hero-name" id="hero-name">{config.name}</h1>
    <p class="hero-eyebrow">{config.tagline}</p>
    <div class="hero-rule" aria-hidden="true"></div>
    <p class="hero-lede">{profile}</p>

    <div class="hero-actions">
      <a class="action action-primary" href="/work">See the work</a>
      <a class="action" href={`mailto:${config.email}`}>Get in touch</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="record-heading">
    <div class="home-head">
      <span class="home-num">01</span>
      <h2 class="home-title" id="record-heading">Track record</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <div class="record">
      {timeline.map((role) => (
        <article class="record-role">
          <div class="record-when">{role.start} → {role.end}</div>
          <div>
            <h3 class="record-title">
              {role.title} <span class="record-employer">{role.employer}</span>
            </h3>
            {role.summary && <p class="record-summary">{role.summary}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* Two readings of the same body of work, side by side: the pieces worth
      showing, and the shape they take across all 59. */}
  <div class="split">
    <section class="home-section" aria-labelledby="selected-heading">
      <div class="home-head">
        <span class="home-num">02</span>
        <h2 class="home-title" id="selected-heading">Selected work</h2>
        <span class="home-rule" aria-hidden="true"></span>
      </div>

      <div class="grid grid-tight">
        {selected.map((project) => (
          <a class="card" href={`/projects/${project.slug}`}>
            <div class="card-meta">
              <span class="card-client">{project.client ?? 'Multiple organisations'}</span>
              <span>{project.year}</span>
            </div>
            <div class="card-title">{project.title}</div>
            <p class="card-desc">{project.summary}</p>
            {project.technologies.length > 0 && (
              <div class="chips">
                {project.technologies.slice(0, 3).map((tech) => <span class="chip">{tech}</span>)}
                {project.technologies.length > 3 && (
                  <span class="chip">+{project.technologies.length - 3}</span>
                )}
              </div>
            )}
          </a>
        ))}
      </div>

      <a class="more" href="/work">All {allProjects.length} projects</a>
    </section>

    <section class="home-section" aria-labelledby="focus-heading">
      <div class="home-head">
        <span class="home-num">03</span>
        <h2 class="home-title" id="focus-heading">What I do</h2>
        <span class="home-rule" aria-hidden="true"></span>
      </div>

      <ul class="focus-list">
        {areas.map((area) => (
          <li>
            <a class="focus" href={`/work?type=${encodeURIComponent(area.name)}`}>
              <span class="focus-name">{area.name}</span>
              <span class="focus-summary" set:html={area.summary} />
              <span class="focus-go">View {area.count} projects</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="home-section" aria-labelledby="caps-heading">
    <div class="home-head">
      <span class="home-num">04</span>
      <h2 class="home-title" id="caps-heading">Capabilities</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    {/* No proficiency meters here: nearly everything is Expert, so the bars said
        nothing. The project count is what actually separates one from another. */}
    <p class="caps-hint">Every skill and tool, with the number of projects behind each.</p>

    {([['Skills', skills], ['Technologies', technologies]] as const).map(([label, items]) => (
      <div class="caps-group">
        <h3 class="caps-group-title">{label}</h3>
        <div class="caps-cloud">
          {items.map((item) => (
            <a class="caps-chip" href={`/capabilities/${item.slug}`}>
              {item.name}
              {item.evidenceCount > 0 && <span class="caps-chip-n">{item.evidenceCount}</span>}
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="home-section" id="contact" aria-labelledby="contact-heading">
    <div class="home-head">
      <span class="home-num">05</span>
      <h2 class="home-title" id="contact-heading">Get in touch</h2>
      <span class="home-rule" aria-hidden="true"></span>
    </div>

    <dl class="contact-grid">
      <div><dt>Email</dt><dd><a href={`mailto:${config.email}`}>{config.email}</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={config.linkedinUrl} rel="noopener noreferrer">{config.linkedin}</a></dd></div>
      <div><dt>GitHub</dt><dd><a href={config.githubUrl} rel="noopener noreferrer">{config.github}</a></dd></div>
      <div><dt>Based in</dt><dd>{config.location}</dd></div>
    </dl>
  </section>
</Site>
