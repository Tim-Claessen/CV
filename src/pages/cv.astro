---
import WebChrome from '../components/WebChrome.astro';
import Header from '../components/Header.astro';
import Profile from '../components/Profile.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import { config, roles, projects, capabilities, persona, resolveMode } from '../lib/career';
import '../styles/cv-theme.css';

// One lens per build, as before: CV_LENS picks it, defaulting to the full view.
// CV_MODE=private swaps anonymised client descriptors back for real names —
// used when exporting a CV for a named application, never for the public site.
const lens = process.env.CV_LENS ?? 'all';
const mode = resolveMode();
const profile = persona(lens)?.profile ?? persona('all')?.profile ?? '';

// The CV is the two-page version, so it carries lore's `featured:` projects only.
// The full 59 live on the portfolio at /, and /build picks any subset of them.
const selected = projects(mode, lens).filter((project) => project.featured);

const title = `${config.name} — CV`;
const fontUrl =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={config.tagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontUrl} />
    <title>{title}</title>
  </head>
  <body>
    <WebChrome />
    <main class="page">
      <Header config={config} />
      <Profile profile={profile} />
      <Experience roles={roles(lens)} config={config} />
      <Projects projects={selected} />
      <Skills groups={capabilities(lens)} />
      <Education />
    </main>
  </body>
</html>
