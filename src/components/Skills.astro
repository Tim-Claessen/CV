---
import SectionHead from './SectionHead.astro';
import { proficiencySegments, type CapabilityGroup } from '../lib/career';

interface Props {
  groups: CapabilityGroup[];
  num?: string;
  title?: string;
  /** One line under the heading, e.g. to say the list is a selection. */
  note?: string;
}

const { groups, num = '04', title = 'Capabilities', note } = Astro.props;
---

<section class="section" aria-labelledby="capabilities-heading">
  <SectionHead num={num} title={title} />
  <div id="capabilities-heading" class="visually-hidden">{title}</div>
  {note && <p class="cap-note">{note}</p>}
  {groups.map((group) => (
    <div class="cap-group">
      <div class="cap-group-title">{group.domain}</div>
      <div class="cap-list cap-list--compact">
        {group.categories
          .flatMap((cat) => cat.items)
          // Flattened, the category sort would interleave levels again.
          .sort((a, b) =>
            proficiencySegments(b.proficiency) - proficiencySegments(a.proficiency) ||
            a.name.localeCompare(b.name))
          .map((item) => {
            const filled = proficiencySegments(item.proficiency);
            return (
              <div class="cap-item cap-item--compact">
                <span class="cap-name">{item.name}</span>
                <span class="cap-level">{item.proficiency}</span>
                <span class="cap-meter" aria-hidden="true">
                  {[1, 2, 3].map((n) => (
                    <span class:list={['cap-seg', { on: n <= filled }]} />
                  ))}
                </span>
              </div>
            );
          })}
      </div>
    </div>
  ))}
</section>
