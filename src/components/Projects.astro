---
import SectionHead from './SectionHead.astro';
import type { Project } from '../lib/career';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="section page-break-before" aria-labelledby="projects-heading">
  <SectionHead num="03" title="Selected projects" />
  <div id="projects-heading" class="visually-hidden">Selected projects</div>
  <div class="projects">
    {projects.map((project) => (
      <div class="project-card" data-project={project.slug}>
        <div class="project-head">
          <span class="project-client">{project.client}</span>
          <span class="project-id">{project.year}</span>
        </div>
        <div class="project-title">{project.title}</div>
        <p class="project-desc">{project.summary}</p>
        {project.technologies.length > 0 && (
          <div class="project-stack" aria-label="Systems">
            {project.technologies.map((technology) => (
              <span class="stack-chip">{technology}</span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</section>
