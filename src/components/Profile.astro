---
import SectionHead from './SectionHead.astro';

interface Props {
  profile: string;
  /** A floated capital can detach the first letter when a CV is parsed as text. */
  dropcap?: boolean;
}

const { profile, dropcap = true } = Astro.props;
const first = profile.charAt(0);
const rest = profile.slice(1);
---

<section class="section" aria-labelledby="profile-heading">
  <SectionHead num="01" title="Profile" />
  <div class="profile-wrap">
    <p class="profile" id="profile-heading">
      {dropcap ? <><span class="dropcap">{first}</span>{rest}</> : profile}
    </p>
  </div>
</section>
