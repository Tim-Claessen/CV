---
import SectionHead from './SectionHead.astro';
import { credentials, community as allCommunity } from '../lib/career';

interface Props {
  /** Community entries to drop by name, for a CV that needs the space. */
  hideCommunity?: string[];
  /** Both are overridable because an application CV reorders its sections. */
  num?: string;
  title?: string;
}

const { hideCommunity = [], num = '05', title = 'Education' } = Astro.props;
const community = allCommunity.filter((entry) => !hideCommunity.includes(entry.name));
---

<section class="section" aria-labelledby="education-heading">
  <SectionHead num={num} title={title} />
  <div class="footer-grid">
    <div>
      <div class="footer-col-title" id="education-heading">Education</div>
      {credentials.map((credential) => (
        <div class="edu-item">
          <div class="edu-qual">{credential.name}</div>
          <div class="edu-inst">{credential.issuer}</div>
          {credential.body && <div class="edu-detail">{credential.body}</div>}
        </div>
      ))}
    </div>
    {community.length > 0 && (
      <div>
        <div class="footer-col-title">Community</div>
        {community.map((entry) => (
          <div class="edu-item">
            <div class="edu-qual">{entry.name}</div>
            {entry.organisation && <div class="edu-inst">{entry.organisation}</div>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
